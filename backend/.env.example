# Experimental recognition settings for local evaluation only.
# Similarity threshold 0.40 and ambiguity margin 0.10 are experimental,
# not calibrated or production-validated.
OFFLINE_FACE_MATCHING_SIMILARITY_THRESHOLD=0.40
OFFLINE_FACE_MATCHING_AMBIGUITY_MARGIN=0.10
# Recognition is disabled by default. Explicitly set this to true to opt in
# to experimental recognition; valid thresholds and ready models are also required.
OFFLINE_FACE_EXPERIMENTAL_RECOGNITION_ENABLED=false
